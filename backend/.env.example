# ---- AI tutor ----------------------------------------------------------------------------
# AI_PROVIDER: auto | openrouter | openai | anthropic | mock | disabled
#   auto picks the provider from the key prefix: sk-or- -> openrouter, sk-ant- -> anthropic,
#   other sk- -> openai. With no key, AI feedback is disabled (the circuit analysis still works).
AI_PROVIDER=
AI_API_KEY=

# Model id for the chosen provider. Leave empty for the default:
#   openrouter -> anthropic/claude-opus-5   (any id from https://openrouter.ai/models, e.g. google/gemini-3.5-flash)
#   anthropic  -> claude-opus-5
#   openai     -> required (e.g. gpt-5.5)
AI_MODEL=nvidia/nemotron-3-super-120b-a12b:free

# Leave empty for the provider default (OpenRouter: https://openrouter.ai/api/v1).
# Set it to use another OpenAI-compatible gateway with AI_PROVIDER=openai.
AI_BASE_URL=

AI_TIMEOUT_SECONDS=60
AI_MAX_TOKENS=4000
AI_ON_CORRECT=true

# OpenRouter / OpenAI only: json_schema (strict; falls back to json_object automatically) | json_object | none
AI_RESPONSE_FORMAT=json_schema
# OpenRouter only (optional): your app's URL, for attribution on openrouter.ai
AI_APP_URL=

# Anthropic only
AI_EFFORT=medium
AI_REFUSAL_FALLBACK=true

# ---- Server --------------------------------------------------------------------------------
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
LOG_LEVEL=INFO

# ---- Request limits ------------------------------------------------------------------------
LIMIT_MAX_INPUTS=12
LIMIT_MAX_GATES=200
LIMIT_MAX_OUTPUTS=16
LIMIT_MAX_CONNECTIONS=1000
LIMIT_MAX_TRUTH_TABLE_VARIABLES=12
LIMIT_MAX_EXPRESSION_LENGTH=4000
LIMIT_MAX_AI_PROMPT_CHARS=60000
